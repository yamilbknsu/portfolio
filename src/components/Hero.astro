---
import { profile } from '../data/profile';
import Icon from './Icon.astro';
import { Picture } from 'astro:assets';
// The source photo stays untouched; Astro writes resized AVIF/WebP copies at build time.
import photo from '../../assets/profile.png';
---

<header class="hero" id="top">
  <canvas class="map" aria-hidden="true"></canvas>
  <div class="scrim" aria-hidden="true"></div>
  <div class="tip" aria-hidden="true"></div>
  <div class="legend" aria-hidden="true">
    <span class="note">Data is decorative plausible noise</span>
    <span class="row"><span>calm</span><span class="bar"></span><span>intense</span></span>
  </div>

  <div class="wrap grid">
    <div class="txt">
      <div class="lab coords">{profile.coords}</div>
      <h1>{profile.name}</h1>
      <p class="role"><b>{profile.headline}</b> · {profile.position}</p>
      <p class="mission">{profile.mission}</p>
      <div class="links">
        <a class="primary" href={`mailto:${profile.email}`}><Icon name="mail" />{profile.email}</a>
        <a href={profile.links.github} rel="me"><Icon name="github" />GitHub</a>
        <a href={profile.links.scholar}><Icon name="scholar" />Scholar</a>
        <a href={profile.links.orcid}><Icon name="orcid" />ORCID</a>
        <a href={profile.links.linkedin} rel="me"><Icon name="linkedin" />LinkedIn</a>
      </div>
    </div>
    <div class="photo">
      <div class="frame">
        <Picture src={photo} formats={['avif', 'webp']} fallbackFormat="jpg" quality={80} width={840} widths={[420, 840]} sizes="(max-width: 820px) 280px, 420px" alt={`Portrait of ${profile.name}`} fetchpriority="high" loading="eager" />
      </div>
    </div>
  </div>
</header>

<script>
  // Load the map engine (d3-geo + land data) after first paint.
  const hero = document.querySelector<HTMLElement>('.hero')!;
  const go = () =>
    import('../scripts/hexmap').then(({ initHexMap }) =>
      initHexMap(hero, hero.querySelector('canvas')!, hero.querySelector<HTMLElement>('.tip')!),
    );
  'requestIdleCallback' in window ? requestIdleCallback(go, { timeout: 800 }) : setTimeout(go, 200);
</script>

<style>
  .hero { position: relative; overflow: hidden; background: var(--hero); color: var(--hero-ink); min-height: 560px; }
  .map { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; transition: opacity 1s ease; }
  :global(.hero.map-ready) .map { opacity: 1; }
  .scrim { position: absolute; inset: 0; pointer-events: none; background: radial-gradient(ellipse 36% 85% at 22% 50%, rgba(5, 9, 19, .85) 0%, rgba(5, 9, 19, .65) 55%, rgba(5, 9, 19, 0) 100%); }
  .tip { position: absolute; left: 0; top: 0; z-index: 4; pointer-events: none; font: 11px var(--mono); color: #e6edf3; background: rgba(5, 9, 19, .85); border: 1px solid rgba(255, 255, 255, .12); padding: 5px 8px; border-radius: 6px; white-space: nowrap; opacity: 0; transition: opacity .15s; }
  .legend { position: absolute; right: 24px; bottom: 16px; z-index: 3; font: 11px var(--mono); color: var(--hero-muted); display: flex; flex-direction: column; align-items: flex-end; gap: 6px; }
  .legend .note { opacity: .7; }
  .legend .row { display: flex; align-items: center; gap: 10px; }
  .legend .bar { width: 120px; height: 6px; border-radius: 99px; background: linear-gradient(90deg, var(--s0), var(--s1), var(--s2), var(--s3), var(--s4)); }

  .grid { position: relative; display: grid; grid-template-columns: 1fr 300px; gap: 48px; align-items: center; padding-top: 64px; padding-bottom: 72px; pointer-events: none; }
  .grid > * { pointer-events: auto; }
  .txt { max-width: 700px; }
  .coords { color: var(--hero-muted); }
  h1 { font-weight: 800; font-size: clamp(52px, 8vw, 86px); line-height: 1; letter-spacing: -.035em; margin: 14px 0 16px; }
  .role { font-size: 18px; margin: 0; color: var(--hero-muted); }
  .role b { font-weight: 600; color: var(--hero-ink); }
  .mission { max-width: 520px; margin: 16px 0 30px; color: var(--hero-muted); font-size: 16px; }
  .links { display: flex; flex-wrap: wrap; gap: 8px; --icon-bg: #0b1220; }
  .links a { display: inline-flex; align-items: center; gap: 8px; font: 13px var(--mono); padding: 8px 14px; border-radius: 8px; background: rgba(255, 255, 255, .06); border: 1px solid rgba(255, 255, 255, .12); transition: all .2s; }
  .links a:hover { border-color: var(--s3); background: rgba(255, 255, 255, .1); color: #fff; transform: translateY(-1px); }
  .links a.primary { background: var(--strong); color: var(--strong-ink); border-color: var(--strong); }
  .links a.primary:hover { background: #fff; color: #111; }

  .photo { width: 300px; aspect-ratio: .866; position: relative; filter: drop-shadow(0 20px 40px rgba(0, 0, 0, .55)); }
  .photo::before { content: ''; position: absolute; inset: -8px; clip-path: var(--hex); background: linear-gradient(160deg, var(--s0), var(--s1), var(--s2), var(--s3), var(--s4)); transition: filter .4s; }
  .photo:hover::before { filter: brightness(1.2) saturate(1.2); }
  /* the photo is scaled 1.4x inside the hex frame and offset so the face (≈62% across, 45% down the source) sits at the centre */
  .frame { position: absolute; inset: 0; clip-path: var(--hex); overflow: hidden; }
  .frame :global(img) { position: absolute; width: 140%; max-width: none; height: auto; left: -36.8%; top: -18.5%; }

  /* on wide screens let the header breathe so the photo sits further right */
  @media (min-width: 1500px) { .grid { max-width: 1340px; } }
  @media (min-width: 1900px) { .grid { max-width: 1520px; } }
  @media (max-width: 820px) {
    .grid { grid-template-columns: 1fr; gap: 36px; padding-top: 48px; padding-bottom: 96px; }
    .photo { width: 200px; order: -1; }
    .scrim { background: rgba(5, 9, 19, .45); }
  }
</style>
