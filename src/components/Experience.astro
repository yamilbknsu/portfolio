---
import { experience } from '../data/experience';
import SectionHead from './SectionHead.astro';
---

<section class="block" id="experience">
  <div class="wrap">
    <SectionHead num="02" kicker="now & before" title="Experience">2019 → now</SectionHead>
    <ol class="tl">
      {experience.map((r) => (
        <li class:list={['role', { current: r.current }]}>
          <div class="when lab">
            {r.start} — {r.end ?? 'now'}
            <span class="place">{r.place}</span>
          </div>
          <span class="node" aria-hidden="true"></span>
          <div class="body">
            <h3>{r.title}</h3>
            <p class="org">{r.org}{r.unit && <span> · {r.unit}</span>}</p>
            {r.bullets && (
              <ul>
                {r.bullets.map((b) => <li>{b}</li>)}
              </ul>
            )}
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .tl { list-style: none; margin: 0; padding: 0; }
  .role { display: grid; grid-template-columns: 170px 28px 1fr; gap: 0 18px; position: relative; padding-bottom: 34px; }
  .role:last-child { padding-bottom: 0; }
  /* the vertical rail */
  .role::before { content: ''; position: absolute; left: calc(170px + 18px + 13px); top: 14px; bottom: -6px; width: 2px; background: var(--line); }
  .role:last-child::before { display: none; }
  .when { padding-top: 3px; text-align: right; }
  .place { display: block; opacity: .75; }
  .node { width: 16px; height: 18px; margin: 4px auto 0; clip-path: var(--hex); background: var(--line); position: relative; z-index: 1; transition: transform .25s, background .25s; }
  .role:hover .node { transform: scale(1.25); background: var(--accent); }
  .current .node { background: var(--v4); box-shadow: 0 0 0 4px rgba(253, 231, 37, .2); }
  .current .node, .current:hover .node { background: #e8c400; }
  h3 { font-size: 18px; font-weight: 700; letter-spacing: -.01em; margin: 0; line-height: 1.35; }
  .org { margin: 2px 0 0; color: var(--ink-2); font-weight: 500; }
  .org span { color: var(--muted); font-weight: 400; }
  ul { margin: 10px 0 0; padding-left: 18px; color: var(--ink-2); font-size: 14.5px; }
  ul li { margin: 4px 0; }
  ul li::marker { color: var(--s3); }
  @media (max-width: 720px) {
    .role { grid-template-columns: 22px 1fr; gap: 4px 14px; }
    .role::before { left: 10px; }
    .when { grid-column: 2; text-align: left; order: -1; }
    .node { grid-row: 1 / span 2; grid-column: 1; margin-top: 4px; }
    .body { grid-column: 2; }
  }
</style>
