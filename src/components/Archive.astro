---
import { archive, archiveCredit } from '../data/misc';
import SectionHead from './SectionHead.astro';
import Icon from './Icon.astro';
---

<section class="block" id="archive">
  <div class="wrap">
    <SectionHead num="09" kicker="from the archive" title="Early work">{archiveCredit}</SectionHead>
    <div class="grid">
      {archive.map((v) => (
        <figure>
          <!-- lightweight embed: a thumbnail until clicked, then a privacy-friendly YouTube iframe -->
          <button class="yt" data-id={v.id} aria-label={`Play video: ${v.title}`}>
            <img src={`https://i.ytimg.com/vi/${v.id}/hqdefault.jpg`} alt="" loading="lazy" width="480" height="360" />
            <span class="play"><Icon name="play" size={22} /></span>
          </button>
          <figcaption>
            <div class="lab">{v.year}</div>
            <div class="name">{v.title}</div>
            <div class="d">{v.caption}</div>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>('#archive .yt').forEach((btn) =>
    btn.addEventListener('click', () => {
      const f = document.createElement('iframe');
      f.src = `https://www.youtube-nocookie.com/embed/${btn.dataset.id}?autoplay=1`;
      f.title = btn.getAttribute('aria-label') ?? 'Video';
      f.allow = 'autoplay; encrypted-media; picture-in-picture';
      f.allowFullscreen = true;
      btn.replaceWith(f);
    }),
  );
</script>

<style>
  .grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; }
  figure { margin: 0; }
  .yt, figure :global(iframe) { display: block; width: 100%; aspect-ratio: 16 / 9; border: 0; border-radius: 10px; overflow: hidden; background: var(--hero); }
  .yt { position: relative; padding: 0; cursor: pointer; }
  .yt img { width: 100%; height: 100%; object-fit: cover; filter: grayscale(.6) brightness(.85); transition: filter .3s, transform .4s; }
  .yt:hover img { filter: none; transform: scale(1.03); }
  .play { position: absolute; inset: 0; margin: auto; width: 48px; height: 54px; clip-path: var(--hex); background: rgba(5, 9, 19, .75); color: #fff; display: grid; place-items: center; transition: background .2s; }
  .yt:hover .play { background: var(--accent); }
  figcaption { margin-top: 10px; }
  .name { font-weight: 650; font-size: 14.5px; line-height: 1.35; }
  .d { color: var(--muted); font-size: 13px; margin-top: 2px; }
  @media (max-width: 960px) { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .grid { grid-template-columns: 1fr; } }
</style>
