---
// Small inline icons. Brand marks are simplified drawings, sized to the text.
interface Props {
  name: 'github' | 'scholar' | 'orcid' | 'linkedin' | 'mail' | 'arrow' | 'play';
  size?: number;
}
const { name, size = 15 } = Astro.props;
---

<svg class="icon" width={size} height={size} viewBox={name === 'github' ? '0 0 16 16' : '0 0 24 24'} aria-hidden="true" fill="currentColor">
  {name === 'github' && (
    <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z" />
  )}
  {name === 'scholar' && (
    <path d="M5.242 13.769L0 9.5 12 0l12 9.5-5.242 4.269C17.548 11.249 14.978 9.5 12 9.5c-2.977 0-5.548 1.748-6.758 4.269zM12 10a7 7 0 1 0 0 14 7 7 0 0 0 0-14z" />
  )}
  {name === 'orcid' && (
    <g>
      <circle cx="12" cy="12" r="11" />
      <text x="12" y="16.2" text-anchor="middle" font-size="11" font-weight="700" font-family="system-ui, sans-serif" fill="var(--icon-bg, #050913)">iD</text>
    </g>
  )}
  {name === 'linkedin' && (
    <g>
      <rect x="1" y="1" width="22" height="22" rx="4" />
      <g fill="var(--icon-bg, #050913)">
        <rect x="5" y="9.5" width="3.2" height="9" />
        <circle cx="6.6" cy="6.4" r="1.9" />
        <path d="M10.4 9.5h3.1v1.3c.5-.9 1.6-1.6 3.1-1.6 2.6 0 3.4 1.6 3.4 4.1v5.2h-3.2v-4.6c0-1.2-.3-2-1.4-2-1.2 0-1.8.8-1.8 2.1v4.5h-3.2z" />
      </g>
    </g>
  )}
  {name === 'mail' && (
    <g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round">
      <rect x="2.5" y="4.5" width="19" height="15" rx="2.5" />
      <path d="m3.5 6.5 8.5 6.5 8.5-6.5" stroke-linecap="round" />
    </g>
  )}
  {name === 'arrow' && (
    <path d="M7 17 17 7M9 7h8v8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
  )}
  {name === 'play' && <path d="M8 5.5v13l11-6.5z" />}
</svg>

<style>
  .icon { display: inline-block; flex: none; vertical-align: -2px; }
</style>
